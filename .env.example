# Copy to .env and fill in. NEVER commit .env.
DB_PASSWORD=change-me-local-only

# Shared key for the generic POST /api/v1/reviews endpoint (X-Api-Key header)
WebhookAuth__ApiKey=change-me-long-random-string

# Review behaviour
Review__TargetStatus=Under Review
Review__MaxContextCharacters=30000
# Groq free tier is limited per minute, keep this low
Review__MaxConcurrentJobs=2

# ---- Llm__Model ----
# Mock = no key, fake reviews (good for first test). Groq = free real LLM. Anthropic = paid.
Llm__Provider=Mock
# Get a free Groq key at https://console.groq.com/keys  (starts with gsk_)
Llm__ApiKey=
# Leave empty for the default (Groq: llama-3.3-70b-versatile). Check console.groq.com/docs/models for current names.
Llm__Model=

# ---- ClickUp ----
ClickUp__BaseUrl=https://api.clickup.com/api/v2
# Personal API token: ClickUp > avatar > Settings > Apps > API Token
ClickUp__ApiToken=
# true = comments are only logged, not posted
ClickUp__DryRun=true
# Secret returned by ClickUp when you register the webhook (scripts/register-clickup-webhook.ps1)
ClickUp__WebhookSecret=
